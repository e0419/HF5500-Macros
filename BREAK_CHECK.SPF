;CHECK CURRENT TOOL USING BLUM TOOL BREAK CONTROL

;--- CHECK IF ACTIVE TOOL IS A PROBE ---
DEF INT _TOOL_TYPE

_TOOL_TYPE = $TC_DP1[$P_TOOLNO,1] ; Active tool, D1 tool type
STOPRE

;IF TOOL = PROBE THEN GOTO END
IF (_TOOL_TYPE == 710) OR (_TOOL_TYPE == 712) OR (_TOOL_TYPE == 713) GOTOF END

;ELSE CONTINUE
;TOOL BREAK CYCLE
CHECK:
MSG("Tool Break Check")

HOME

;BL9908(ROFFS,MDIR,LBREAK,CORLEN)
;ROFFS = RADIAL CHECKING POSITION
;MDIR = MEASURING DIRECTION
;LBREAK = LENGTH TOLERANCE
;CORLEN = ADDITIVE LENGTH OFFSET (WEAR)
M9
M20
S3750 M3
G4F1.
S3750M4
G4F1.
S3750M3

D1
G4F5.0


;NCG#BL9908#bguilas.com#PRGCODE#*NCG;*RO*;*HD*
;###"1=dark->light"#4#1#1###""#0.03#0#"\\"#""#"\\"#"png"#"png"#"png"#1#0##3##25.4#"1=dark->light"#"\\bsk_cncl.png"#"\\bsk_ok.png"#2#1#0#"BL9908"#*NCG;*RO*;*HD*
BL9908(,1,0.03,0)
;#END#*NCG;*RO*;*HD*

HOME

END:
M17
