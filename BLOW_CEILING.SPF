DEF INT _SAVED_TOOL_NO
DEF STRING[32] _SAVED_TOOL
STOPRE
_SAVED_TOOL_NO=$TC_MPP6[9998,1]
_SAVED_TOOL = $TC_TP2[_SAVED_TOOL_NO]


HOME
T="BLOWOFF"
M6
M20
G04 F5. ;DWELL TO BLOW OUT COOLANT LINES

G53 G0 A-180
N1
G53 G0 X17.5 

BLOW:
G53 G1 X-17.5 F200 ;ADJUST FEED / PASSES AS NEEDED
G53 G1 X17.5
OFF:
REPEAT BLOW OFF P3 ;P= NUMBER OF PASSES



T = _SAVED_TOOL ;SWITCH BACK TO OTHER TOOL
M6

M17


